<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GameVault</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Jersey+10&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <section class="banner">
      <div class="carousel">
        <img src="imagens/tlou2-banner.png" class="slide active">
        <img src="imagens/tlou2r-banner.jpg" class="slide">
        <img src="imagens/tlou1-banner.png" class="slide">
        <div class="indicators">
          <span class="dot active" onclick="goToSlide(0)"></span>
          <span class="dot" onclick="goToSlide(1)"></span>
          <span class="dot" onclick="goToSlide(2)"></span>
        </div>
      </div>
    </section>

    <h2 class="titulo">Jogos mais avaliados</h2>
    <%- include('partials/carrossel') %>

<section class="games-content">
  <!-- Sidebar de filtros -->
  <aside class="sidebar">
    <div class="filter-panel">
      <h3>Gênero</h3>
      <div class="search-box">
        <input type="text" placeholder="Pesquise" class="search-input" />
        <span class="search-icon">🔍</span>
      </div>
      <ul>
        <li><label><input type="checkbox" /> Ação e Aventura</label></li>
        <li><label><input type="checkbox" /> Terror</label></li>
        <li><label><input type="checkbox" /> Cooperativo</label></li>
        <li><label><input type="checkbox" /> Plataforma</label></li>
        <li><label><input type="checkbox" /> FPS</label></li>
        <li><label><input type="checkbox" /> RPG</label></li>
      </ul>
    </div>

    <div class="filter-panel">
      <h3>Relevâncias</h3>
      <div class="search-box">
        <input type="text" placeholder="Pesquise" />
        <span class="search-icon">🔍</span>
      </div>
      <ul>
        <li><label><input type="checkbox" /> Mais Jogados</label></li>
        <li><label><input type="checkbox" /> Menos Jogados</label></li>
        <li><label><input type="checkbox" /> 5 estrelas</label></li>
        <li><label><input type="checkbox" /> 4 estrelas</label></li>
        <li><label><input type="checkbox" /> Últimos lançados</label></li>
        <li><label><input type="checkbox" /> Mais antigos</label></li>
      </ul>
    </div>
  </aside>

  <!-- Grid de jogos + paginação -->
  <div class="games-section">
    <div class="game-grid" id="game-grid">
      <p style="grid-column:1/-1;text-align:center;color:#aaa;">Carregando jogos…</p>
    </div>

    <div class="pagination">
      <button class="prev">&lsaquo;</button>
      <button class="page active" aria-label="Página 1"></button>
      <button class="page" aria-label="Página 2"></button>
      <button class="page" aria-label="Página 3"></button>
      <button class="next">&rsaquo;</button>
    </div>
  </div>
</section>

    
  <%- include('partials/footer') %>

  <%- include('partials/modals') %>
  <script src="script.js"></script>
  <script>
    /* ── Catálogo dinâmico de jogos ── */
    (function () {
      const API = 'http://localhost:3000';
      const grid = document.getElementById('game-grid');
      if (!grid) return;

      const FALLBACK = 'imagens/logoGV.png';

      function estrelas(media) {
        const m = Math.round(media || 0);
        let h = "";
        for (let i = 1; i <= 5; i++) h += `<span class="star">${i <= m ? "★" : "☆"}</span>`;
        return h;
      }

      function card(j) {
        const img = j.JOG_IMG ? `${API}/uploads/${j.JOG_IMG}` : FALLBACK;
        const nome = j.JOG_NOME || 'Sem nome';
        const media = j.media ? Number(j.media) : 0;
        const nota = media > 0 ? media.toFixed(1) : '–';
        return `
          <a class="game-card" href="descJogo.html?id=${j.JOG_COD}" style="text-decoration:none;color:inherit;">
            <img src="${img}" alt="${nome}" onerror="this.onerror=null;this.src='${FALLBACK}'" />
            <div class="card-body">
              <p class="title">${nome}</p>
              <div class="rating">
                <div class="stars">${estrelas(media)}</div>
                <span class="rating-number">${nota}</span>
              </div>
            </div>
          </a>`;
      }

      fetch(`${API}/jogos`)
        .then(r => r.json())
        .then(jogos => {
          if (!Array.isArray(jogos) || jogos.length === 0) {
            grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;color:#aaa;">Nenhum jogo cadastrado ainda.</p>';
            return;
          }
          grid.innerHTML = jogos.map(card).join('');
        })
        .catch(() => {
          grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;color:#aaa;">Erro ao carregar jogos. O servidor está rodando?</p>';
        });
    })();
  </script>
</body>
</html>
