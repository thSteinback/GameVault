<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>GameVault – Perfil</title>
  <link rel="stylesheet" href="style.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Jersey+10&display=swap" rel="stylesheet"/>
</head>
<body>
  <%- include('partials/header') %>

  <main class="perfil-main">
    <section class="perfil-banner">
      <form id="form-banner" enctype="multipart/form-data" style="position: absolute; top: 15px; right: 15px;">
        <input type="file" name="banner" id="banner" accept="image/*" style="display:none" />
        <button type="button" onclick="document.getElementById('banner').click()">Alterar Fundo</button>
        <button type="submit" style="display:none"></button>
      </form>
    </section>

    <div class="perfil-info">
      <div class="avatar-container">
        <img src="imagens/oMimico.png" alt="Avatar" class="avatar" />
        <h2 class="username"></h2>
        <p class="membro"></p>
        <form id="form-avatar" enctype="multipart/form-data">
          <input type="file" name="avatar" id="avatar" accept="image/*" required />
          <button type="submit">Alterar Avatar</button>
        </form>
      </div>

      <div class="perfil-bloco-unico">
        <div class="stats-container">
          <div class="stat">
            <span class="icon">🤍</span>
            <span class="number">0</span>
            <span class="label">Favoritos</span>
          </div>
          <div class="stat">
            <span class="icon">☆ ☆ ☆ ☆ ☆</span>
            <span class="number">0</span>
            <span class="label">Avaliações</span>
          </div>
          <div class="stat">
            <span class="icon">💬</span>
            <span class="number">0</span>
            <span class="label">Comentários</span>
          </div>
        </div>

        <div class="favoritos-games">
          <div class="game-card"><img src="imagens/jogo4.jpg" alt="Jogo 1"/></div>
          <div class="game-card"><img src="imagens/jogo5.jpg" alt="Jogo 2"/></div>
          <div class="game-card"><img src="imagens/jogo6.jpg" alt="Jogo 3"/></div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <%- include('partials/modals') %>
  <script src="script.js"></script>
  <script>
    /* ── Estatísticas e favoritos reais do perfil ── */
    (function () {
      const API = 'http://localhost:3000';
      const FALLBACK = 'imagens/logoGV.png';
      const usuarioLogado = localStorage.getItem('usuarioLogado');
      if (!usuarioLogado) return;

      const nums = document.querySelectorAll('.stats-container .stat .number');
      // ordem no HTML: [0] Favoritos, [1] Avaliações, [2] Comentários
      fetch(`${API}/usuario-perfil?nome=${encodeURIComponent(usuarioLogado)}`)
        .then(r => r.json())
        .then(d => {
          if (d && !d.erro) {
            if (nums[0]) nums[0].textContent = d.favoritos ?? 0;
            if (nums[1]) nums[1].textContent = d.avaliacoes ?? 0;
            if (nums[2]) nums[2].textContent = d.comentarios ?? 0;
          }
        })
        .catch(() => {});

      const cont = document.querySelector('.favoritos-games');
      if (cont) {
        fetch(`${API}/favoritos?nome=${encodeURIComponent(usuarioLogado)}`)
          .then(r => r.json())
          .then(jogos => {
            if (!Array.isArray(jogos) || !jogos.length) {
              cont.innerHTML = '<p style="color:#aaa;">Nenhum jogo favoritado ainda.</p>';
              return;
            }
            cont.innerHTML = jogos.slice(0, 6).map(j => {
              const img = j.JOG_IMG ? `${API}/uploads/${j.JOG_IMG}` : FALLBACK;
              const nome = (j.JOG_NOME || 'Jogo').replace(/"/g, '&quot;');
              return `<div class="game-card">
                        <a href="descJogo.html?id=${j.JOG_COD}">
                          <img src="${img}" alt="${nome}" onerror="this.onerror=null;this.src='${FALLBACK}'" />
                        </a>
                      </div>`;
            }).join('');
          })
          .catch(() => {});
      }
    })();
  </script>
</body>
</html>
