  <!-- Modal de Login -->
  <div id="loginModal" class="modal">
    <div class="modal-content">
      <span class="close">&times;</span>
      <h2>Conecte-se</h2>
      <label>Usuário</label><br />
      <input type="text" id="loginUsuario" placeholder="Digite seu usuário"><br />
      <span class="erro" id="erroLoginUsuario"></span>
      <label>Senha</label><br />
      <input type="password" id="loginSenha" placeholder="Digite sua senha"><br />
      <span class="erro" id="erroLoginSenha"></span>
      <a href="#" class="esqueci">Esqueceu a senha?</a><br />
      <button id="btnLogin">Entrar</button>
      <p class="registro">Não possui conta? <a href="#" id="trocarParaCadastro">Registre-se</a></p>
    </div>
  </div>
  <!-- Modal de Cadastro -->
  <div id="cadastroModal" class="modal">
    <div class="modal-content">
      <span class="close">&times;</span>
      <h2>Junte-se ao Gamevault</h2>
      <label>Email</label><br />
      <input type="email" id="cadastroEmail" placeholder="Digite seu e-mail"><br />
      <span class="erro" id="erroCadastroEmail"></span>
      <label>Usuário</label><br />
      <input type="text" id="cadastroUsuario" placeholder="Escolha um nome de usuário"><br />
      <span class="erro" id="erroCadastroUsuario"></span>
      <label>Senha</label><br />
      <input type="password" id="cadastroSenha" placeholder="Crie uma senha"><br />
      <span class="erro" id="erroCadastroSenha"></span>
      <label>Confirmar senha</label><br />
      <input type="password" id="cadastroConfirmarSenha" placeholder="Confirme a senha"><br />
      <span class="erro" id="erroCadastroConfirmarSenha"></span>
      <button id="btnCadastro">Cadastrar</button>
      <p class="registro">Já possui conta? <a href="#" id="trocarParaLogin">Conecte-se</a></p>
    </div>
  </div>
