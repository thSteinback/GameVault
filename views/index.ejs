<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GameVault</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Jersey+10&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <section class="banner">
      <div class="carousel">
        <img src="imagens/tlou2-banner.png" class="slide active">
        <img src="imagens/tlou2r-banner.jpg" class="slide">
        <img src="imagens/tlou1-banner.png" class="slide">
        <div class="indicators">
          <span class="dot active" onclick="goToSlide(0)"></span>
          <span class="dot" onclick="goToSlide(1)"></span>
          <span class="dot" onclick="goToSlide(2)"></span>
        </div>
      </div>
    </section>

    <h2 class="titulo">Jogos mais avaliados</h2>
    <div class="top-jogos-wrapper" style="position:relative;max-width:1100px;margin:0 auto;">
      <button id="topPrev" class="nav left" style="position:absolute;left:-6px;top:50%;transform:translateY(-50%);z-index:2;cursor:pointer;">&#10094;</button>
      <div id="topJogos" style="display:flex;gap:16px;overflow-x:auto;scroll-behavior:smooth;padding:10px 28px;">
        <p style="color:#aaa;">Carregando...</p>
      </div>
      <button id="topNext" class="nav right" style="position:absolute;right:-6px;top:50%;transform:translateY(-50%);z-index:2;cursor:pointer;">&#10095;</button>
    </div>

    <section class="analises">
      <h2>Análises populares</h2>
      <div id="analises-container"></div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <%- include('partials/modals') %>
  <script src="script.js"></script>
  <script>
    /* ── Home dinâmica: mais avaliados + análises recentes ── */
    (function () {
      const API = 'http://localhost:3000';
      const FALLBACK = 'imagens/logoGV.png';
      const esc = s => { const d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; };
      const estrelas = m => { m = Math.round(m || 0); let h = ''; for (let i = 1; i <= 5; i++) h += (i <= m ? '★' : '☆'); return h; };

      // Jogos mais avaliados
      const faixa = document.getElementById('topJogos');
      if (faixa) {
        fetch(`${API}/jogos/top`).then(r => r.json()).then(js => {
          if (!Array.isArray(js) || !js.length) { faixa.innerHTML = '<p style="color:#aaa;">Nenhum jogo cadastrado ainda.</p>'; return; }
          faixa.innerHTML = js.map(j => {
            const img = j.JOG_IMG ? `${API}/uploads/${j.JOG_IMG}` : FALLBACK;
            const nome = esc(j.JOG_NOME || 'Jogo');
            const media = j.media ? Number(j.media) : 0;
            return `<a href="descJogo.html?id=${j.JOG_COD}" style="flex:0 0 auto;width:150px;text-decoration:none;color:inherit;">
                      <img src="${img}" alt="${nome}" onerror="this.onerror=null;this.src='${FALLBACK}'" style="width:150px;height:200px;object-fit:cover;border-radius:8px;display:block;" />
                      <p style="margin:6px 0 0;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${nome}</p>
                      <span style="color:#f5c518;font-size:13px;">${estrelas(media)} ${media > 0 ? media.toFixed(1) : ''}</span>
                    </a>`;
          }).join('');
        }).catch(() => { faixa.innerHTML = '<p style="color:#aaa;">Erro ao carregar.</p>'; });
        const prev = document.getElementById('topPrev'), next = document.getElementById('topNext');
        if (prev) prev.onclick = () => faixa.scrollBy({ left: -330, behavior: 'smooth' });
        if (next) next.onclick = () => faixa.scrollBy({ left: 330, behavior: 'smooth' });
      }

      // Análises populares (comentários recentes)
      const cont = document.getElementById('analises-container');
      if (cont) {
        fetch(`${API}/comentarios/recentes`).then(r => r.json()).then(cs => {
          if (!Array.isArray(cs) || !cs.length) { cont.innerHTML = '<p style="color:#aaa;">Ainda não há análises. Seja o primeiro a comentar um jogo!</p>'; return; }
          cont.innerHTML = cs.map(c => {
            const img = c.JOG_IMG ? `${API}/uploads/${c.JOG_IMG}` : FALLBACK;
            return `<div class="analise">
                      <img src="${img}" class="capa" onerror="this.onerror=null;this.src='${FALLBACK}'">
                      <div class="detalhes">
                        <div class="titulo-jogo"><h3>${esc(c.JOG_NOME)}</h3></div>
                        <div class="usuario"><div class="avatar"></div><span class="nome">${esc(c.USU_NOME)}</span></div>
                        <p class="comentario">${esc(c.COM_TEXTO)}</p>
                        <a href="descJogo.html?id=${c.JOG_COD}" style="font-size:13px;color:#8C8CFF;text-decoration:none;">Ver jogo &rarr;</a>
                      </div>
                    </div>`;
          }).join('');
        }).catch(() => { cont.innerHTML = '<p style="color:#aaa;">Erro ao carregar análises.</p>'; });
      }
    })();
  </script>
</body>
</html>
